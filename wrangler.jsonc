{
  "name": "healthy-hannah",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Created automatically on first deploy if it doesn't exist yet.
  "d1_databases": [
    { "binding": "DB", "database_name": "healthy-hannah" }
  ],
  // Reminder check every 15 minutes (skips itself when the day is already done).
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
